    },
    {
      "name": "notification",
      "prefix": "cus",
      "style": "solid",
      "collection": "custom",
      "project": "Project C",
      "oldPath": "svg/Custom/Project C/notification.svg",
      "newPath": "svg/solid/cus-solid-notification.svg",
      "className": "mis-cus-solid-notification"
    }
  ]
}
